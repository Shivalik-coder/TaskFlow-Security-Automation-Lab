      "name": "return saved task"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Run Once for Each Item. Input is one proposed task, not an array.\nconst t = $json;\nfor (const k of ['dedupeKey','ruleId','assetId','title','owner','reason']) {\nif (typeof t[k] !== 'string' || !t[k].trim()) {\nthrow new Error('Missing task field: ' + k);\n}\n}\nif (!['LOW','MEDIUM','HIGH','CRITICAL'].includes(t.priority)) {\nthrow new Error('Invalid priority');\n}\nreturn { json: { ...t, observedAt: t.observedAt || new Date().toISOString() } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
