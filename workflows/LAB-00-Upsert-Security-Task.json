        -16,
        48
      ],
      "id": "4b13d63f-e1a3-4f5b-a962-3fea36fbb9ff",
      "name": "Verify saved task"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const saved = $json.body;\nconst expected = $('Choose write').item.json.body;\nif (!saved || saved.dedupeKey !== expected.dedupeKey ||\nsaved.priority !== expected.priority || saved.status !== 'open') {\nthrow new Error('Task read-back did not match the requested write');\n}\nreturn {json: saved};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
