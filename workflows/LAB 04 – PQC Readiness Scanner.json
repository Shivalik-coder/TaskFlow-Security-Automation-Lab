              "name": "score",
              "value": "=\n{{ !$json.hasInventory ? 0\n : !$json.hasRoadmap ? 1\n : !$json.hasTestEnvironment ? 2\n : !$json.hasHybridTest ? 3\n : (!$json.hasProduction || $json.simulated === true) ? 4\n : 5 }}\n",
