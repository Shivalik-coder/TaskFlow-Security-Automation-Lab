      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "24914262-4522-41ba-8cf1-8203034dd051",
              "name": "readinessStatus",
              "value": "=\n{{ Array.isArray($json.blockers) && $json.blockers.length > 0\n  ? 'Blocked'\n  : $json.score === 5\n    ? 'Migrated'\n    : $json.score === 0\n      ? 'Unknown'\n      : $json.vendorControlled === true && $json.score < 4\n        ? 'Vendor-dependent'\n        : $json.score >= 3\n          ? 'Testing'\n          : 'Inventoried' }}\n",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
